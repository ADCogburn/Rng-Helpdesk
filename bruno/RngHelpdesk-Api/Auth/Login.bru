meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "password"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Logs in as the dev-seeded admin/password account (created by Program.cs's
  IsDevelopment() seeding block on startup). Saves the returned JWT into the
  {{token}} environment variable, which every other request in this collection
  sends as `Authorization: Bearer {{token}}` via the collection's bearer auth.

  Run this first after starting the API.
}
