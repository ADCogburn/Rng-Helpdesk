meta {
  name: Change Password
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "password",
    "newPassword": "a-new-password"
  }
}

docs {
  Changes the logged-in user's password and clears their must-change-password flag.
  Returns 204 on success, 400 with a plain-string error if currentPassword is wrong,
  or a validation problem if newPassword is shorter than 8 characters or equal to
  currentPassword.

  Note: running this as the dev-seeded admin changes the password away from `password`
  for as long as Postgres persists, so Auth/Login will need the new value afterward.
  Swap the two fields to change it back.
}
