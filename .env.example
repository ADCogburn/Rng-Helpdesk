# Copy to .env (gitignored) and set a real password to override docker-compose.yml's
# placeholder default. Use the same value in `dotnet user-secrets` for RngHelpdesk.Api
# (ConnectionStrings:RngHelpdeskDB) so the app can authenticate against the container.
POSTGRES_DB=rnghelpdesk_dev
POSTGRES_USER=rnghelpdesk_app
POSTGRES_PASSWORD=
